pipeline {
    agent any
    
    parameters {
        string(name: 'APP_BRANCH', defaultValue: 'main', description: 'Branch o Commit SHA di karateflow-fe da testare')
    }
    
    environment {
        GITHUB_CREDENTIALS = credentials('github-token-secret')
    }
    
    tools {
        nodejs 'Node20'
    }
    
    stages {
        stage('Checkout e Init') {
            steps {
                git url: 'https://github.com/KarateFlow/karateflow-fe.git', branch: "${params.APP_BRANCH}"
                
                script {
                    env.COMMIT_SHA = sh(script: 'git rev-parse HEAD', returnStdout: true).trim()
                }

                sh """
                    curl -H "Authorization: token \$GITHUB_CREDENTIALS" \
                         -H "Accept: application/vnd.github.v3+json" \
                         -X POST \
                         -d '{"state": "pending", "context": "continuous-integration/jenkins/ci", "description": "CI e Quality Gate in corso...", "target_url": "${env.BUILD_URL}"}' \
                         https://api.github.com/repos/KarateFlow/karateflow-fe/statuses/\$COMMIT_SHA
                """
            }
        }
        
        stage('Install Dependencies') {
            steps {
                sh 'npm install'
            }
        }
        
        stage('Lint') {
            steps {
                sh 'npm run lint'
            }
        }
        
        stage('Test') {
            steps {
                sh """
                    if grep -q '"@vitest/coverage-v8"' package.json; then
                        npm run test -- --no-watch --coverage
                    else
                        npm run test -- --no-watch
                    fi
                """
            }
        }

        stage('SonarQube Analysis & Quality Gate') {
            steps {
                withCredentials([string(credentialsId: 'sonar-token', variable: 'SONAR_TOKEN')]) {
                    sh """
                        SCANNER_VERSION="8.0.1.6346"
                        ARCH=\$(uname -m)
                        if [ "\$ARCH" = "aarch64" ] || [ "\$ARCH" = "arm64" ]; then
                            SCANNER_FLAVOR="linux-aarch64"
                        else
                            SCANNER_FLAVOR="linux-x64"
                        fi
                        
                        SCANNER_ZIP="sonar-scanner-cli-\${SCANNER_VERSION}-\${SCANNER_FLAVOR}.zip"
                        SCANNER_DIR="\$HOME/.sonar/native-sonar-scanner/\${SCANNER_VERSION}"
                        
                        if [ ! -d "\$SCANNER_DIR" ]; then
                            echo "Downloading native SonarScanner for \${SCANNER_FLAVOR}..."
                            mkdir -p "\$SCANNER_DIR"
                            if ! command -v unzip >/dev/null; then
                                if command -v apt-get >/dev/null; then
                                    apt-get update && apt-get install -y unzip
                                elif command -v apk >/dev/null; then
                                    apk add --no-cache unzip
                                fi
                            fi
                            if ! command -v curl >/dev/null; then
                                if command -v apt-get >/dev/null; then
                                    apt-get update && apt-get install -y curl
                                elif command -v apk >/dev/null; then
                                    apk add --no-cache curl
                                fi
                            fi
                            curl -sSLo "/tmp/\${SCANNER_ZIP}" "https://binaries.sonarsource.com/Distribution/sonar-scanner-cli/\${SCANNER_ZIP}"
                            unzip -o "/tmp/\${SCANNER_ZIP}" -d "\$SCANNER_DIR"
                            rm "/tmp/\${SCANNER_ZIP}"
                        fi
                        
                        SCANNER_PATH=\$(find "\$SCANNER_DIR" -maxdepth 2 -type d -name "sonar-scanner-*" | head -n 1)
                        echo "Using SonarScanner at: \$SCANNER_PATH"
                        
                        LCOV_PROP=""
                        if [ -f "coverage/karateflow-fe/lcov.info" ]; then
                            LCOV_PROP="-Dsonar.javascript.lcov.reportPaths=coverage/karateflow-fe/lcov.info"
                        fi
                        
                        "\$SCANNER_PATH/bin/sonar-scanner" \
                            -Dsonar.host.url=http://sonarqube.local \
                            -Dsonar.token=\${SONAR_TOKEN} \
                            -Dsonar.projectKey=karateflow-fe \
                            -Dsonar.sources=src \
                            -Dsonar.qualitygate.wait=true \
                            \$LCOV_PROP
                    """
                }
            }
        }
    }
    
    post {
        success {
            sh """
                curl -H "Authorization: token \$GITHUB_CREDENTIALS" \
                     -H "Accept: application/vnd.github.v3+json" \
                     -X POST \
                     -d '{"state": "success", "context": "continuous-integration/jenkins/ci", "description": "CI e Quality Gate superati!", "target_url": "${env.BUILD_URL}"}' \
                     https://api.github.com/repos/KarateFlow/karateflow-fe/statuses/\$COMMIT_SHA
            """
        }
        failure {
            sh """
                curl -H "Authorization: token \$GITHUB_CREDENTIALS" \
                     -H "Accept: application/vnd.github.v3+json" \
                     -X POST \
                     -d '{"state": "failure", "context": "continuous-integration/jenkins/ci", "description": "CI o Quality Gate falliti. Controlla i log.", "target_url": "${env.BUILD_URL}"}' \
                     https://api.github.com/repos/KarateFlow/karateflow-fe/statuses/\$COMMIT_SHA
            """
        }
    }
}
