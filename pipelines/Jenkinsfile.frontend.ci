pipeline {
    agent any
    
    parameters {
        string(name: 'APP_BRANCH', defaultValue: 'main', description: 'Branch o Commit SHA di karateflow-fe da testare')
    }
    
    environment {
        GITHUB_CREDENTIALS = credentials('github-token-secret')
    }
    
    tools {
        nodejs 'Node20'
    }
    
    stages {
        stage('Checkout e Init') {
            steps {
                git url: 'https://github.com/KarateFlow/karateflow-fe.git', branch: "${params.APP_BRANCH}"
                
                script {
                    env.COMMIT_SHA = sh(script: 'git rev-parse HEAD', returnStdout: true).trim()
                }

                sh """
                    curl -H "Authorization: token \$GITHUB_CREDENTIALS" \
                         -H "Accept: application/vnd.github.v3+json" \
                         -X POST \
                         -d '{"state": "pending", "context": "continuous-integration/jenkins/ci", "description": "CI e Quality Gate in corso...", "target_url": "${env.BUILD_URL}"}' \
                         https://api.github.com/repos/KarateFlow/karateflow-fe/statuses/\$COMMIT_SHA
                """
            }
        }
        
        stage('Install Dependencies') {
            steps {
                sh 'npm install'
            }
        }
        
        stage('Lint') {
            steps {
                sh 'npm run lint'
            }
        }
        
        stage('Test') {
            steps {
                sh 'npm run test -- --no-watch'
            }
        }

        stage('SonarQube Analysis & Quality Gate') {
            steps {
                withCredentials([string(credentialsId: 'sonar-token', variable: 'SONAR_TOKEN')]) {
                    sh """
                        npx @sonar/scan \
                            -Dsonar.host.url=http://sonarqube.local \
                            -Dsonar.token=\${SONAR_TOKEN} \
                            -Dsonar.projectKey=karateflow-fe \
                            -Dsonar.sources=src \
                            -Dsonar.qualitygate.wait=true
                    """
                }
            }
        }
    }
    
    post {
        success {
            sh """
                curl -H "Authorization: token \$GITHUB_CREDENTIALS" \
                     -H "Accept: application/vnd.github.v3+json" \
                     -X POST \
                     -d '{"state": "success", "context": "continuous-integration/jenkins/ci", "description": "CI e Quality Gate superati!", "target_url": "${env.BUILD_URL}"}' \
                     https://api.github.com/repos/KarateFlow/karateflow-fe/statuses/\$COMMIT_SHA
            """
        }
        failure {
            sh """
                curl -H "Authorization: token \$GITHUB_CREDENTIALS" \
                     -H "Accept: application/vnd.github.v3+json" \
                     -X POST \
                     -d '{"state": "failure", "context": "continuous-integration/jenkins/ci", "description": "CI o Quality Gate falliti. Controlla i log.", "target_url": "${env.BUILD_URL}"}' \
                     https://api.github.com/repos/KarateFlow/karateflow-fe/statuses/\$COMMIT_SHA
            """
        }
    }
}
