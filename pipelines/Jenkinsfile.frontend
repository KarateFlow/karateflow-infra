pipeline {
    agent any
    
    parameters {
        string(name: 'APP_BRANCH', defaultValue: 'main', description: 'Branch o Commit SHA di karateflow-fe da testare')
    }
    
    environment {
        GITHUB_CREDENTIALS = credentials('github-token-secret')
        
        LOCAL_REGISTRY = '192.168.1.50:32000' 
        IMAGE_NAME = 'karateflow-fe'
    }
    
    tools {
        nodejs 'Node20'
    }
    
    stages {
        stage('Checkout e Init') {
            steps {
                git url: 'https://github.com/KarateFlow/karateflow-fe.git', branch: "${params.APP_BRANCH}"
                
                script {
                    env.COMMIT_SHA = sh(script: 'git rev-parse HEAD', returnStdout: true).trim()
                }

                sh """
                    curl -H "Authorization: token \$GITHUB_CREDENTIALS" \
                         -H "Accept: application/vnd.github.v3+json" \
                         -X POST \
                         -d '{"state": "pending", "context": "continuous-integration/jenkins", "description": "Analisi e Build in corso...", "target_url": "${env.BUILD_URL}"}' \
                         https://api.github.com/repos/KarateFlow/karateflow-fe/statuses/\$COMMIT_SHA
                """
            }
        }
        
        stage('Install Dependencies') {
            steps {
                sh 'npm install'
            }
        }
        
        stage('Lint') {
            steps {
                sh 'npm run lint'
            }
        }
        
        stage('Test') {
            steps {
                sh 'npm run test -- --no-watch'
            }
        }
        
        stage('Angular Build') {
            steps {
                sh 'npm run build'
            }
        }

        stage('Build Docker Image') {
            steps {
                // Il Dockerfile multi-stage eseguirà la build ottimizzata per staging e impacchetterà Nginx
                sh """
                    docker build -t ${env.LOCAL_REGISTRY}/${env.IMAGE_NAME}:${env.COMMIT_SHA} \
                                 -t ${env.LOCAL_REGISTRY}/${env.IMAGE_NAME}:latest .
                """
            }
        }

        stage('Push to Registry') {
            steps {
                sh """
                    docker push ${env.LOCAL_REGISTRY}/${env.IMAGE_NAME}:${env.COMMIT_SHA}
                    docker push ${env.LOCAL_REGISTRY}/${env.IMAGE_NAME}:latest
                """
            }
        }

        stage('Deploy to K3s Staging') {
            steps {
                withCredentials([file(credentialsId: 'k3s-kubeconfig', variable: 'KUBECONFIG_FILE')]) {
                    sh """
                        export KUBECONFIG=\$KUBECONFIG_FILE
                        
                        # Sostituito 'karateflow-fe' con il corretto nome del container 'nginx-angular'
                        kubectl set image deployment/frontend-deployment nginx-angular=${env.LOCAL_REGISTRY}/${env.IMAGE_NAME}:${env.COMMIT_SHA} -n karateflow-stg
                        
                        kubectl rollout status deployment/frontend-deployment -n karateflow-stg
                    """
                }
            }
        }
    }
    
    post {
        success {
            sh """
                curl -H "Authorization: token \$GITHUB_CREDENTIALS" \
                     -H "Accept: application/vnd.github.v3+json" \
                     -X POST \
                     -d '{"state": "success", "context": "continuous-integration/jenkins", "description": "Deploy in Staging completato!", "target_url": "${env.BUILD_URL}"}' \
                     https://api.github.com/repos/KarateFlow/karateflow-fe/statuses/\$COMMIT_SHA
            """
            // Pulizia delle immagini docker locali sul PC per risparmiare spazio
            sh "docker rmi ${env.LOCAL_REGISTRY}/${env.IMAGE_NAME}:${env.COMMIT_SHA} ${env.LOCAL_REGISTRY}/${env.IMAGE_NAME}:latest || true"
        }
        failure {
            sh """
                curl -H "Authorization: token \$GITHUB_CREDENTIALS" \
                     -H "Accept: application/vnd.github.v3+json" \
                     -X POST \
                     -d '{"state": "failure", "context": "continuous-integration/jenkins", "description": "Build o Deploy fallito. Controlla i log.", "target_url": "${env.BUILD_URL}"}' \
                     https://api.github.com/repos/KarateFlow/karateflow-fe/statuses/\$COMMIT_SHA
            """
        }
    }
}