pipeline {
    agent any
    
    parameters {
        string(name: 'APP_BRANCH', defaultValue: 'main', description: 'Branch o Commit SHA di karateflow-be da compilare e distribuire')
    }
    
    environment {
        GITHUB_CREDENTIALS = credentials('github-token-secret')
        LOCAL_REGISTRY = '192.168.1.50:32000' 
        IMAGE_NAME = 'karateflow-be'
    }
    
    stages {
        
        stage('Checkout e Init') {
            steps {
                git url: 'https://github.com/KarateFlow/karateflow-be.git', branch: "${params.APP_BRANCH}"
                
                script {
                    env.COMMIT_SHA = sh(script: 'git rev-parse HEAD', returnStdout: true).trim()
                }

                sh """
                    curl -H "Authorization: token \$GITHUB_CREDENTIALS" \
                         -H "Accept: application/vnd.github.v3+json" \
                         -X POST \
                         -d '{"state": "pending", "context": "continuous-integration/jenkins/cd", "description": "Deploy in Staging in corso...", "target_url": "${env.BUILD_URL}"}' \
                         https://api.github.com/repos/KarateFlow/karateflow-be/statuses/\$COMMIT_SHA
                """
            }
        }
        
        stage('Build Docker Image') {
            steps {
                sh """
                    docker build -t ${env.LOCAL_REGISTRY}/${env.IMAGE_NAME}:${env.COMMIT_SHA} \
                                 -t ${env.LOCAL_REGISTRY}/${env.IMAGE_NAME}:latest .
                """
            }
        }

        stage('Push to Registry') {
            steps {
                // Inviamo le immagini al registro locale sul Raspberry Pi con logica di retry per gestire carichi/latenze temporanee
                sh """
                    push_with_retry() {
                        local img=\$1
                        local max_attempts=3
                        local attempt=1
                        until docker push "\$img" || [ \$attempt -eq \$max_attempts ]; do
                            echo "Push fallito per \$img. Tentativo \$attempt di \$max_attempts. Riprovo in 5 secondi..."
                            sleep 5
                            attempt=\$((attempt + 1))
                        done
                        if [ \$attempt -eq \$max_attempts ]; then
                            echo "Errore: Push di \$img fallito dopo \$max_attempts tentativi."
                            exit 1
                        fi
                    }
                    push_with_retry "${env.LOCAL_REGISTRY}/${env.IMAGE_NAME}:${env.COMMIT_SHA}"
                    push_with_retry "${env.LOCAL_REGISTRY}/${env.IMAGE_NAME}:latest"
                """
            }
        }

        stage('Deploy to K3s Staging') {
            steps {
                withCredentials([file(credentialsId: 'k3s-kubeconfig', variable: 'KUBECONFIG_FILE')]) {
                    sh """
                        # Configurazione del file kubeconfig
                        export KUBECONFIG=\$KUBECONFIG_FILE
                        
                        # Aggiorniamo l'immagine nel deployment di Kubernetes 
                        kubectl set image deployment/backend-deployment spring-boot=${env.LOCAL_REGISTRY}/${env.IMAGE_NAME}:${env.COMMIT_SHA} -n karateflow-stg
                        
                        # Monitoraggio del rollout
                        kubectl rollout status deployment/backend-deployment -n karateflow-stg
                    """
                }
            }
        }
    }
    
    post {
        success {
            sh """
                curl -H "Authorization: token \$GITHUB_CREDENTIALS" \
                     -H "Accept: application/vnd.github.v3+json" \
                     -X POST \
                     -d '{"state": "success", "context": "continuous-integration/jenkins/cd", "description": "Deploy in Staging completato!", "target_url": "${env.BUILD_URL}"}' \
                     https://api.github.com/repos/KarateFlow/karateflow-be/statuses/\$COMMIT_SHA
            """
            // Pulizia immagini docker locali per risparmio spazio
            sh "docker rmi ${env.LOCAL_REGISTRY}/${env.IMAGE_NAME}:${env.COMMIT_SHA} ${env.LOCAL_REGISTRY}/${env.IMAGE_NAME}:latest || true"
        }
        failure {
            sh """
                curl -H "Authorization: token \$GITHUB_CREDENTIALS" \
                     -H "Accept: application/vnd.github.v3+json" \
                     -X POST \
                     -d '{"state": "failure", "context": "continuous-integration/jenkins/cd", "description": "Deploy in Staging fallito.", "target_url": "${env.BUILD_URL}"}' \
                     https://api.github.com/repos/KarateFlow/karateflow-be/statuses/\$COMMIT_SHA
            """
        }
    }
}
